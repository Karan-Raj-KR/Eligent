{
  "manifest_version": 3,
  "name": "Cutoff — Scholarship Autofill",
  "version": "0.1.0",
  "description": "Fills a scholarship form from your saved profile, but only for scholarships you are actually eligible for. Never submits anything.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.vercel.app/*",
    "https://*.buddy4study.com/*",
    "https://*.reliancefoundation.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "https://*.vercel.app/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cutoff"
  }
}
